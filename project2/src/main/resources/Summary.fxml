<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="400.0" prefWidth="600.0" styleClass="root-pane"
           stylesheets="@retro.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="se233.project2.controller.Summary">
   <children>
      <StackPane styleClass="frame" />

      <VBox alignment="CENTER" spacing="14.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <Text fx:id="resultText" styleClass="result-text" text="RESULT" textAlignment="CENTER" />
            <Text fx:id="scoreText" styleClass="score-text" text="SCORE: 0" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="26.0" />
               </VBox.margin>
            </Text>

            <Button fx:id="retryButton" onAction="#onRetryClicked" defaultButton="true"
                    mnemonicParsing="false" prefHeight="44.0" prefWidth="180.0"
                    styleClass="arcade-button" text="RETRY" />
            <Button fx:id="quitButton" onAction="#onQuitClicked"
                    mnemonicParsing="false" prefHeight="44.0" prefWidth="180.0"
                    styleClass="arcade-button, secondary" text="QUIT" />
         </children>
      </VBox>
   </children>
</StackPane>
