<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="400.0" prefWidth="600.0" styleClass="root-pane"
           stylesheets="@retro.css"
           xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="se233.project2.controller.StartMenu">
   <children>
      <StackPane styleClass="frame" />

      <VBox alignment="CENTER" spacing="16.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <Text styleClass="title-text" text="ARKANOID" />
            <Text styleClass="sub-text" text="- BREAK ALL THE BRICKS -">
               <VBox.margin>
                  <Insets bottom="24.0" />
               </VBox.margin>
            </Text>

            <Button fx:id="startButton" onAction="#onStartClicked" defaultButton="true"
                    mnemonicParsing="false" prefHeight="48.0" prefWidth="200.0"
                    styleClass="arcade-button" text="START" />
            <Button fx:id="exitButton" onAction="#onExitClicked"
                    mnemonicParsing="false" prefHeight="48.0" prefWidth="200.0"
                    styleClass="arcade-button, secondary" text="EXIT" />

            <Text styleClass="hint-text" text="← → MOVE   SPACE LAUNCH BALL">
               <VBox.margin>
                  <Insets top="16.0" />
               </VBox.margin>
            </Text>
         </children>
      </VBox>
   </children>
</StackPane>
